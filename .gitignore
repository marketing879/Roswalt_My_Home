# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets - never commit these
lib/config/secrets.dart
extensions/*.env
extensions/*.secret.local

# Signing keystore and credentials - never commit these
*.jks
*.keystore
key.properties
android/key.properties

# Machine-specific
.flutter-plugins
android/local.properties

# Node dependencies (Cloud Functions) - reinstalled via npm install
node_modules/

# Firebase CLI local cache
.firebase/

# Ad-hoc debug output
flutter_log*.txt
